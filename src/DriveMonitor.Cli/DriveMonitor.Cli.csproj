<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DriveMonitorTargetFramework)</TargetFramework>
    <AssemblyName>drivemon</AssemblyName>
    <RootNamespace>DriveMonitor.Cli</RootNamespace>
    <RuntimeIdentifiers>$(DriveMonitorRuntimeIdentifiers)</RuntimeIdentifiers>
    <!-- The self-test's unbuffered read needs a sector-aligned native buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriveMonitor.Core\DriveMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TraceEvent loads its native DLLs from <architecture>\ next to its own assembly or, in a single-file
      app, next to the exe; KernelTraceControl.dll is needed to start the kernel session. A single-file
      bundle would extract them to a temporary folder, where TraceEvent does not look, so they stay
      beside the exe.
    -->
    <None Update="@(None->WithMetadataValue('Filename', 'KernelTraceControl'))" ExcludeFromSingleFile="true" />
    <None Update="@(None->WithMetadataValue('Filename', 'msdia140'))" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
