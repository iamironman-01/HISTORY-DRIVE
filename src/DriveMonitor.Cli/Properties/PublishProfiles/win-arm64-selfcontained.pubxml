<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file build for Windows on ARM64; needs no .NET install.
  dotnet publish src/DriveMonitor.Cli/DriveMonitor.Cli.csproj -p:PublishProfile=win-arm64-selfcontained
  Output: drivemon.exe, plus TraceEvent's native DLLs in arm64\ beside it (see the csproj).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- PublishSingleFile turns on the single-file analyzer, which adds an implicit PackageReference
         to Microsoft.NET.ILLink.Tasks at the SDK's own version. That package would then have to be in
         packages.lock.json, and every other locked restore would fail with NU1004. With the analyzer
         off, its IL3xxx warnings are not reported by this profile. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishDir>bin\publish\win-arm64-selfcontained\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
