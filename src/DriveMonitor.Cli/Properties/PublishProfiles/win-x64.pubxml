<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent build for 64-bit Windows; needs the .NET 9 Runtime.
  dotnet publish src/DriveMonitor.Cli/DriveMonitor.Cli.csproj -p:PublishProfile=win-x64
  Output: drivemon.exe and its DLLs, with TraceEvent's native DLLs in amd64\.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
