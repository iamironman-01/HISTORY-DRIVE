<Window x:Class="DriveMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveMonitor — file activity on your drives"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <Grid DockPanel.Dock="Right" Width="300" Margin="12,0,2,0" VerticalAlignment="Top">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" TabIndex="20"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search path or process"
                             ToolTip="Show only rows whose path or process name contains this text (Ctrl+F)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" Margin="11,0,0,0"
                               HorizontalAlignment="Left" Foreground="{StaticResource TertiaryTextBrush}" IsHitTestVisible="False" />
                    <TextBlock Text="Search path or process…" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TertiaryTextBrush}"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                    <Button Style="{StaticResource SearchClearButton}" HorizontalAlignment="Right" Margin="0,0,5,0" TabIndex="21"
                            Command="{Binding ClearSearchCommand}" ToolTip="Clear the search (Esc)"
                            AutomationProperties.Name="Clear search"
                            Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource VisibleWhen}}" />
                </Grid>

                <!-- Wraps onto a second line when the window is too narrow for one. -->
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartStopCommand}" TabIndex="1"
                            AutomationProperties.Name="{Binding StartStopText}"
                            ToolTip="Start or stop watching the selected drives">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="{Binding StartStopGlyph}" />
                            <TextBlock Text="{Binding StartStopText}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsPaused}" TabIndex="2"
                                  AutomationProperties.Name="Pause view"
                                  ToolTip="Freeze the Live activity list to read it. New events are kept and appear when you resume.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE769;" />
                            <TextBlock Text="Pause view" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding AutoScroll}" TabIndex="3"
                                  AutomationProperties.Name="Auto-scroll"
                                  ToolTip="Keep the newest activity in view (not while a column sort is applied)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE74B;" />
                            <TextBlock Text="Auto-scroll" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding GroupRepeated}" TabIndex="4"
                                  AutomationProperties.Name="Group repeated operations"
                                  ToolTip="Show repeated reads, writes and opens of the same file by the same program as one row (×12)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE8FD;" />
                            <TextBlock Text="Group repeated operations" />
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparator}" />

                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCommand}" TabIndex="5"
                            AutomationProperties.Name="Clear"
                            ToolTip="Clear all tables and totals">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE74D;" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnMenuButtonClick" TabIndex="6"
                            AutomationProperties.Name="Export"
                            ToolTip="Save a table as a CSV file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xEDE1;" />
                            <TextBlock Text="Export" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="7,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Live activity as CSV (visible rows)…" Command="{Binding ExportActivityCommand}" />
                                <MenuItem Header="Files as CSV…" Command="{Binding ExportFilesCommand}" />
                                <MenuItem Header="Processes as CSV…" Command="{Binding ExportProcessesCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Margin="0" TabIndex="7" AutomationProperties.Name="Record log"
                                  IsChecked="{Binding IsLogging, Mode=OneWay}" Command="{Binding ToggleLogCommand}"
                                  ToolTip="Write every event to a CSV file in %LOCALAPPDATA%\DriveMonitor\Logs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE7C8;" />
                            <TextBlock Text="Record log" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="OnMenuButtonClick" TabIndex="8"
                            ToolTip="Log options" AutomationProperties.Name="Log options">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open logs folder" Command="{Binding OpenLogsFolderCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE838;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Banners: error = red, info = blue, administrator rights = amber -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Banners}" Margin="12,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Banner" Margin="0,8,0,0" Padding="12,6,6,6" CornerRadius="8" BorderThickness="1"
                            Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}">
                        <DockPanel>
                            <TextBlock x:Name="BannerGlyph" DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="16"
                                       Margin="0,0,10,0" Text="{Binding Glyph}" Foreground="{StaticResource InfoBannerTextBrush}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource BannerCloseButton}" Command="{Binding CloseCommand}"
                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss message" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource BannerActionButton}" Margin="12,0,6,0"
                                    Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                    Visibility="{Binding ActionText, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock x:Name="BannerText" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{StaticResource InfoBannerTextBrush}" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="Banner" Property="Background" Value="{StaticResource ErrorBannerBrush}" />
                            <Setter TargetName="Banner" Property="BorderBrush" Value="{StaticResource ErrorBannerBorderBrush}" />
                            <Setter TargetName="BannerGlyph" Property="Foreground" Value="{StaticResource ErrorBannerTextBrush}" />
                            <Setter TargetName="BannerText" Property="Foreground" Value="{StaticResource ErrorBannerTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter TargetName="Banner" Property="Background" Value="{StaticResource WarningBannerBrush}" />
                            <Setter TargetName="Banner" Property="BorderBrush" Value="{StaticResource WarningBannerBorderBrush}" />
                            <Setter TargetName="BannerGlyph" Property="Foreground" Value="{StaticResource WarningBannerTextBrush}" />
                            <Setter TargetName="BannerText" Property="Foreground" Value="{StaticResource WarningBannerTextBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Main area: drives and filters | tables -->
        <Grid Grid.Row="2" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="220" MaxWidth="560" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" TabIndex="30">
                    <StackPanel Margin="12,14,12,14">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="DRIVES" />
                        <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Margin="0,0,0,6" Padding="9,8" CornerRadius="6" BorderThickness="1"
                                            Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}">
                                        <CheckBox Style="{StaticResource DriveCheckBox}" TabIndex="30"
                                                  IsChecked="{Binding IsMonitored}" IsEnabled="{Binding IsConnected}"
                                                  AutomationProperties.Name="{Binding Title}"
                                                  ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource IconText}" FontSize="18" VerticalAlignment="Top"
                                                           Margin="0,0,10,0" Text="{Binding Glyph}" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Subtitle}" TextWrapping="Wrap"
                                                               Margin="0,1,0,0" />
                                                    <TextBlock x:Name="RateLine" Style="{StaticResource SecondaryText}" Text="{Binding RateText}"
                                                               Margin="0,5,0,0" />
                                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding TotalsText}"
                                                               Visibility="{Binding TotalsText, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                            </Grid>
                                        </CheckBox>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitored}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentSubtleBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="RateLine" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <!-- A removed drive: plain card; the disabled check box fades its content. -->
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter TargetName="Card" Property="Background" Value="Transparent" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="SHOW" Margin="2,14,0,6" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="40" Content="Reads" IsChecked="{Binding ShowReads}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="41" Content="Writes" IsChecked="{Binding ShowWrites}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="42" Content="Created" IsChecked="{Binding ShowCreated}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="43" Content="Deleted" IsChecked="{Binding ShowDeleted}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="44" Content="Renamed" IsChecked="{Binding ShowRenamed}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="45" Content="Opens" IsChecked="{Binding ShowOpens}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="46" Content="Folder listings" IsChecked="{Binding ShowListings}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="47" Content="Other changes" IsChecked="{Binding ShowOtherChanges}"
                                  ToolTip="Attribute, timestamp and size changes, and flushes to the device" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="48" Content="Paging I/O" IsChecked="{Binding ShowPaging}"
                                  ToolTip="Reads and writes by the Windows cache and memory manager (read-ahead, lazy writes, mapped files). They repeat data a program already read or wrote." />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="49" Content="Failed operations" IsChecked="{Binding ShowFailed}"
                                  ToolTip="Operations Windows refused, e.g. a file that was not found or access denied" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="OPTIONS" Margin="2,14,0,6" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="50" Content="Hide DriveMonitor's own activity"
                                  IsChecked="{Binding HideOwnActivity}" ToolTip="For example saving an export or a log onto a monitored drive" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="51" Content="Monitor new USB drives automatically"
                                  IsChecked="{Binding AutoMonitorNewDrives}" />
                        <CheckBox Style="{StaticResource OptionCheckBox}" TabIndex="52" Content="Start monitoring when DriveMonitor opens"
                                  IsChecked="{Binding AutoStart}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False" />

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0,0,0,4">
                <TabControl x:Name="MainTabs" Style="{StaticResource Tabs}" SelectionChanged="OnTabSelectionChanged" TabIndex="60">

                    <!-- Live activity -->
                    <TabItem AutomationProperties.Name="Live activity">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Live activity" />
                                <TextBlock Style="{StaticResource TabCount}" Text="{Binding ActivityCountText}" />
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid x:Name="ActivityGrid" Style="{StaticResource DataGridStyle}" RowStyle="{StaticResource ActivityRow}"
                                  ItemsSource="{Binding Activity.View}" AutomationProperties.Name="Live activity"
                                  Sorting="OnGridSorting" MouseDoubleClick="OnGridMouseDoubleClick"
                                  PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                                  ContextMenuOpening="OnGridContextMenuOpening">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open containing folder" Command="{Binding OpenFolderCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE838;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Filter to this file" Command="{Binding FilterToFileCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE71C;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Filter to this process" Command="{Binding FilterToProcessCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="FirstTime" Width="96"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="Operation" SortMemberPath="Operation" Width="86"
                                                        ClipboardContentBinding="{Binding OperationText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OperationBadge}">
                                                <TextBlock Style="{StaticResource OperationBadgeText}" Text="{Binding OperationText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Count" Binding="{Binding CountText}" SortMemberPath="Count" Width="58"
                                                    ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="78"
                                                    ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTemplateColumn Header="File" SortMemberPath="FileName" Width="4*" MinWidth="200"
                                                        ClipboardContentBinding="{Binding Path}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ToolTip}"><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Folder, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" /></TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" SortMemberPath="ProcessName" Width="132"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" SortMemberPath="ProcessId" Width="60"
                                                    ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Details" Binding="{Binding DetailsText}" CanUserSort="False" Width="2*" MinWidth="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                            <Setter Property="ToolTip" Value="{Binding DetailsText}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Files -->
                    <TabItem AutomationProperties.Name="Files">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Files" />
                                <TextBlock Style="{StaticResource TabCount}" Text="{Binding FilesCountText}" />
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid x:Name="FilesGrid" Style="{StaticResource DataGridStyle}"
                                  ItemsSource="{Binding Files.View}" AutomationProperties.Name="Files"
                                  Sorting="OnGridSorting" MouseDoubleClick="OnGridMouseDoubleClick"
                                  PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                                  ContextMenuOpening="OnGridContextMenuOpening">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open containing folder" Command="{Binding OpenFolderCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE838;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Filter to this file" Command="{Binding FilterToFileCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE71C;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Path" SortMemberPath="Path" Width="3*" MinWidth="200"
                                                        ClipboardContentBinding="{Binding Path}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ToolTip}"><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Folder, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" /></TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Reads" Binding="{Binding Reads, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Reads" Width="58" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Read bytes" Binding="{Binding BytesRead, Converter={StaticResource BytesText}}"
                                                    SortMemberPath="BytesRead" Width="80" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Writes" Binding="{Binding Writes, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Writes" Width="58" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Written bytes" Binding="{Binding BytesWritten, Converter={StaticResource BytesText}}"
                                                    SortMemberPath="BytesWritten" Width="92" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Opens" Binding="{Binding Opens, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Opens" Width="54" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTemplateColumn Header="Status" SortMemberPath="StatusText" Width="1.4*" MinWidth="110"
                                                        ClipboardContentBinding="{Binding StatusText}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                                                       Foreground="{Binding StatusOperation, Converter={StaticResource OperationForeground}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last activity" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="88"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Last operation" Binding="{Binding LastOperationText}" SortMemberPath="LastOperationText"
                                                    Width="96" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Processes" Binding="{Binding Processes}" SortMemberPath="Processes" Width="1.4*"
                                                    MinWidth="110" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Processes -->
                    <TabItem AutomationProperties.Name="Processes">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Processes" />
                                <TextBlock Style="{StaticResource TabCount}" Text="{Binding ProcessesCountText}" />
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid x:Name="ProcessesGrid" Style="{StaticResource DataGridStyle}"
                                  ItemsSource="{Binding Processes.View}" AutomationProperties.Name="Processes"
                                  Sorting="OnGridSorting" MouseDoubleClick="OnGridMouseDoubleClick"
                                  PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                                  ContextMenuOpening="OnGridContextMenuOpening">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Filter to this process" Command="{Binding FilterToProcessCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE71C;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" SortMemberPath="ProcessName" Width="2*"
                                                    MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" SortMemberPath="ProcessId" Width="64"
                                                    ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Reads" Binding="{Binding Reads, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Reads" Width="64" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Read bytes" Binding="{Binding BytesRead, Converter={StaticResource BytesText}}"
                                                    SortMemberPath="BytesRead" Width="86" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Writes" Binding="{Binding Writes, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Writes" Width="64" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Written bytes" Binding="{Binding BytesWritten, Converter={StaticResource BytesText}}"
                                                    SortMemberPath="BytesWritten" Width="92" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Created" Binding="{Binding Creates, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Creates" Width="66" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Deleted" Binding="{Binding Deletes, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Deletes" Width="66" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Renamed" Binding="{Binding Renames, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Renames" Width="70" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Files" Binding="{Binding Files, Converter={StaticResource CountText}}"
                                                    SortMemberPath="Files" Width="58" ElementStyle="{StaticResource CellTextRight}" />
                                <DataGridTextColumn Header="Last activity" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="1*"
                                                    MinWidth="90" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding PausedText}" Foreground="{StaticResource StatusAmberBrush}"
                               Visibility="{Binding PausedText, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Style="{StaticResource StatusItem}" Text="● Recording log" Foreground="{StaticResource StatusRedBrush}"
                               Visibility="{Binding IsLogging, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusGreyBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Monitoring">
                                        <Setter Property="Fill" Value="{StaticResource StatusGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                        <Setter Property="Fill" Value="{StaticResource StatusAmberBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Stopping">
                                        <Setter Property="Fill" Value="{StaticResource StatusAmberBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource StatusRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding StateText}"
                               ToolTip="{Binding DiagnosticsText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Monitoring">
                                        <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource StatusRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding EventRateText}"
                               ToolTip="Events per second on the monitored drives" />
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding PublishedText}"
                               ToolTip="Events on the monitored drives since DriveMonitor started" />
                    <TextBlock Text="{Binding LostText}"
                               ToolTip="The kernel dropped events because they were produced faster than they could be read.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLostEvents}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource StatusRedBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding DroppedText}"
                               ToolTip="Events DriveMonitor discarded because the display could not keep up with them." />
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding UnnamedText}"
                               ToolTip="I/O on files that were already open before monitoring started; Windows did not report their names. Counted for all drives, not only the monitored ones, because without a name the drive is unknown." />
                    <TextBlock Style="{StaticResource StatusItem}" Text="{Binding TrackedFilesText}"
                               ToolTip="Files with totals in the Files tab" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
