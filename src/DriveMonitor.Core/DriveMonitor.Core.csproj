<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DriveMonitorTargetFramework)</TargetFramework>
    <RootNamespace>DriveMonitor.Core</RootNamespace>
    <!-- Publishing the app or the CLI with -r also restores this library for that runtime. -->
    <RuntimeIdentifiers>$(DriveMonitorRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriveMonitor.Tests" />
    <!-- The CLI self-test records raw kernel fields through MonitorEngine.RawOperationObserver. -->
    <InternalsVisibleTo Include="drivemon" />
  </ItemGroup>

</Project>
